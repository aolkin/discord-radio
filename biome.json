{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "static/**/*.js",
      "static/**/*.css",
      "static/**/*.html",
      "!static/alpine.min.js"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 4,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    },
    "globals": [
      "Alpine"
    ]
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "linter": {
    "rules": {
      "correctness": "error",
      "suspicious": {
        "noShadow": "error"
      },
      "style": {
        "useBlockStatements": "error",
        "useConsistentObjectDefinitions": "error",
        "useNumberNamespace": "error"
      }
    }
  }
}
