# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# Where persisted state and activity logs are written (defaults to ./bot-state)
STATE_STORE_PATH=./bot-state

# Web Portal Configuration
WEB_PORT=3000
# WEB_CORS_ALLOWED_ORIGINS=http://example.com,https://example.com  # Optional: comma-separated list of allowed origins (defaults to localhost only)

# Grafana Cloud Metrics (Optional)
# GRAFANA_METRICS_URL=https://otlp-gateway-prod-us-central-0.grafana.net/otlp/v1/metrics
# GRAFANA_API_KEY=your_grafana_cloud_api_key

# S3-compatible Object Storage (e.g. Cloudflare R2)
# Used by the Discord bot for remote content storage
BUCKET_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BUCKET_ACCESS_KEY_ID=your-access-key-id
BUCKET_SECRET_ACCESS_KEY=your-secret-access-key
BUCKET_NAME=your-bucket-name
BUCKET_CACHE_DIR=./bucket-cache
